# Copy this file to .env (which Git ignores) and fill in your own values.

# Local MongoDB:      mongodb://127.0.0.1:27017
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name (created automatically on first write)
MONGODB_DB=rabbit_trails

PORT=3000
